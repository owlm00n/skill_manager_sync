{
  "default_instance": "unisoc",
  "instances": {
    "unisoc": {
      "name": "Unisoc Bugzilla（内网）",
      "base_url": "https://bugzilla.unisoc.com/bugzilla",
      "rest_url": "https://bugzilla.unisoc.com/bugzilla/rest",
      "api_key": "GzzXtl8A0nU5M8HmTbnYYt0Yapc3skDCRfI0vmaa",
      "user": "",
      "status_map": {
        "needinfo": "Need_Info",
        "assigned": "Assigned",
        "resolved": "Resolved",
        "closed": "Closed",
        "reopened": "Reopened",
        "rootcause": "Root-Caused",
        "rootcaused": "Root-Caused",
        "codecommitted": "Code-Committed",
        "fixed": "Fixed",
        "tobeverified": "TobeVerified",
        "reopen": "ReOpen",
        "wontfix": "WONTFIX",
        "duplicated": "Duplicated",
        "invalided": "Invalided"
      },
      "ftp_host": "unitrans.unisoc.com",
      "ftp_port": "2443",
      "ftp_user": "ctd01",
      "ftp_password": "ctd01@abAB",
      "ftp_use_ssl": true,
      "rayfile_exe": "E:\\08_Bug\\sync-cmd-windows\\rayfile-c_cmd.exe",
      "default_workspace": "E:\\08_Bug",
      "workspace_routing": {
        "internal": {
          "pattern": "^\\d+$",
          "description": "内部 Bugzilla Bug（纯数字 ID）",
          "base_path": "E:\\08_Bug",
          "naming": "Bug {id} - {title}"
        },
        "customer_cq": {
          "pattern": "^SPCSS\\d+$",
          "description": "客户 CQ Bug（SPCSS 前缀），需解析 alias 获取 Bugzilla ID",
          "base_path": "E:\\08_Bug\\CQ",
          "naming": "Bug {bugzilla_id}({alias}) - {title}",
          "alias_resolution": {
            "method": "REST API",
            "endpoint": "/rest/bug?quicksearch={alias}",
            "mapping": "alias 字段关联 Bugzilla Bug，取第一个匹配 Bug 的 id",
            "note": "SPCSS ID 本身不是 Bugzilla ID，必须解析 alias 后才能获知真实 Bug ID"
          }
        },
        "task": {
          "pattern": "^SPCSS\\d+$",
          "description": "SPCSS EnhancementRequest/需求 — 手动指定 Task 路由，不通过 pattern 自动匹配",
          "base_path": "E:\\08_Bug\\Task",
          "naming": "Bug {bugzilla_id}({alias}) - {title}",
          "manual_only": true,
          "alias_resolution": {
            "method": "REST API",
            "endpoint": "/rest/bug?quicksearch={alias}",
            "mapping": "alias 字段关联 Bugzilla Bug，取第一个匹配 Bug 的 id",
            "note": "manual_only=true，不会通过 pattern 自动匹配，必须调用方显式传 routing_key='task'"
          }
        }
      },
      "status_required_fields": {
        "Root-Caused": {
          "cf_root_cause": "[1.Root Cause]",
          "cf_resolution": "[2.Resolution]",
          "cf_testing_suggestion": "[3.Testing Suggestion]",
          "cf_impact_customer": "[4.Impact for customer]"
        },
        "Fixed": {},
        "Code-Committed": {},
        "Need_Info": {},
        "Assigned": {},
        "Resolved": {},
        "Closed": {},
        "Reopened": {},
        "TobeVerified": {},
        "WONTFIX": {},
        "Duplicated": {},
        "Invalided": {}
      },
      "notes": "办公网可用，需API key，绿网不可达。附件通过rayfile下载"
    },
    "local": {
      "name": "本地模拟数据",
      "base_url": "local",
      "rest_url": "local",
      "api_key": "",
      "notes": "离线模式，使用 sample_bugs.json 模拟数据"
    }
  }
}
